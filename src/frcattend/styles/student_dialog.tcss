/* Styles for the edit student dialog in view/student_dialog.py. */


#student-dialog {
    width: 80;
    height: 35;
    overflow-y: auto;
}

#student-dialog Input {
    margin-bottom: 0;
}

#student-dialog Horizontal {
    margin-top: 1;
    align: center middle;
}

#student-status {
    width: 80;
    height: auto;
    overflow-y: auto;
}

#student-status Horizontal {
    margin-top: 1;
    align: center middle;
}

#status-notes {
    height: 4;
}